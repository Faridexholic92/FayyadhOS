diff --git a/app/src/main/java/com/gathin/tvhome/JarvisAiClient.java b/app/src/main/java/com/gathin/tvhome/JarvisAiClient.java
new file mode 100644
index 0000000..27ff18a
--- /dev/null
+++ b/app/src/main/java/com/gathin/tvhome/JarvisAiClient.java
@@ -0,0 +1,54 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.content.RestrictionsManager;
+import android.os.Bundle;
+import org.json.JSONObject;
+import javax.net.ssl.HttpsURLConnection;
+import java.net.URL;
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+
+/** HTTPS only. Provider key never enters Android. Configuration is provisioned, not compiled. */
+class JarvisAiClient {
+ private final Context context;
+ private volatile HttpsURLConnection connection;
+ private volatile boolean cancelled;
+ JarvisAiClient(Context c){context=c.getApplicationContext();}
+ String explain(JSONObject facts)throws Exception{
+  if(cancelled)throw new InterruptedIOException();
+  RestrictionsManager manager=(RestrictionsManager)context.getSystemService(Context.RESTRICTIONS_SERVICE);
+  Bundle managed=manager==null?null:manager.getApplicationRestrictions();
+  // Private preferences support trusted provisioning on unmanaged TVs; no exported intent accepts secrets.
+  android.content.SharedPreferences prefs=context.getSharedPreferences("jarvis-backend",0);
+  String endpoint=managed!=null&&managed.containsKey("jarvis_endpoint")?managed.getString("jarvis_endpoint",""):prefs.getString("endpoint","");
+  String token=managed!=null&&managed.containsKey("jarvis_device_token")?managed.getString("jarvis_device_token",""):prefs.getString("device_token","");
+  if(endpoint.isEmpty()||token.isEmpty())throw new Failure("Backend not configured on this TV");
+  URL url=new URL(endpoint);
+  if(!"https".equals(url.getProtocol())||url.getHost().isEmpty()||url.getUserInfo()!=null||url.getRef()!=null||url.getQuery()!=null)
+   throw new Failure("Backend requires a valid HTTPS endpoint");
+  HttpsURLConnection c=(HttpsURLConnection)url.openConnection();connection=c;
+  try{
+   if(cancelled)throw new InterruptedIOException();
+   c.setConnectTimeout(5000);c.setReadTimeout(18000);c.setInstanceFollowRedirects(false);c.setUseCaches(false);
+   c.setRequestMethod("POST");c.setDoOutput(true);c.setRequestProperty("Content-Type","application/json");
+   c.setRequestProperty("Accept","application/json");c.setRequestProperty("Authorization","Bearer "+token);
+   byte[] body=new JSONObject().put("action","explain_network").put("context",facts).toString().getBytes(StandardCharsets.UTF_8);
+   c.setFixedLengthStreamingMode(body.length);
+   try(OutputStream out=c.getOutputStream()){out.write(body);}
+   int status=c.getResponseCode();
+   if(status!=200)throw new Failure(status==401?"TV authorization rejected":status==429?"Busy or rate limited; try again shortly":status==503?"Backend or provider is not configured":status==504?"Request timed out":"Backend request failed (HTTP "+status+")");
+   String type=c.getContentType();if(type==null||!type.toLowerCase(java.util.Locale.ROOT).contains("application/json"))throw new Failure("Invalid backend response");
+   try(InputStream in=c.getInputStream();ByteArrayOutputStream out=new ByteArrayOutputStream()){
+    byte[] buffer=new byte[2048];int n;
+    while((n=in.read(buffer))!=-1){if(cancelled||Thread.currentThread().isInterrupted())throw new InterruptedIOException();if(out.size()+n>16384)throw new Failure("Backend response too large");out.write(buffer,0,n);}
+    JSONObject result=new JSONObject(out.toString("UTF-8"));Object text=result.opt("text");
+    if(!(text instanceof String)||((String)text).trim().isEmpty()||((String)text).length()>2400||!"groq".equals(result.optString("provider")))throw new Failure("Invalid backend response");
+    return ((String)text).trim();
+   }
+  }finally{c.disconnect();connection=null;}
+ }
+ void cancel(){cancelled=true;HttpsURLConnection c=connection;if(c!=null)c.disconnect();}
+ static String safeError(Exception e){return e instanceof Failure?e.getMessage():e instanceof java.net.SocketTimeoutException?"Request timed out":"Connection failed; check the network and backend";}
+ static final class Failure extends IOException {Failure(String message){super(message);}}
+}
